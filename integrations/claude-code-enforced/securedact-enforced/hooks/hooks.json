{
  "description": "SecuRedact deterministic privacy enforcement",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-m", "securedact_enforced.claude_hook", "--event", "session-start"],
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-m", "securedact_enforced.claude_hook", "--event", "user-prompt-submit"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(mcp__.*|WebFetch|WebSearch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-m", "securedact_enforced.provider_hook"],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-m", "securedact_enforced.claude_hook", "--event", "session-end"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
